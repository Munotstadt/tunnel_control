# Kopieren nach erp_app.env (liegt neben docker-compose.yml, wird NICHT eingecheckt)

# Datenbank munot_erp auf dem NAS (Container munot_erp_db)
PGHOST=192.168.86.30
PGPORT=5434
PGDATABASE=munot_erp
PGUSER=erp_app
PGPASSWORD=

# Die App lauscht nur auf 127.0.0.1 des NAS (nicht im LAN erreichbar)
PORT=13000
TZ=Europe/Zurich
