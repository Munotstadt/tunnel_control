# Kopieren nach .env (liegt neben docker-compose.yml, wird NICHT eingecheckt)

# Gleicher Wert wie das Worker-Secret NAS_TOKEN
NAS_TOKEN=

# Cloudflare Access Service Token (Zero Trust > Access controls > Service credentials)
# Leer lassen, solange die Access-App fuer nas/* noch auf Bypass steht
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
